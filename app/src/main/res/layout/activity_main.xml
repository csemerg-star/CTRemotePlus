<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
<LinearLayout
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="CT Remote+" android:textColor="@color/text_white" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvDeviceName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Aucun appareil" android:textColor="@color/text_gray" android:textSize="12sp" android:paddingEnd="8dp"/>
        <ImageButton android:id="@+id/btnSettings" android:layout_width="36dp" android:layout_height="36dp"
            android:background="@drawable/btn_circle" android:src="@android:drawable/ic_menu_manage" android:contentDescription="Reglages"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:background="@drawable/btn_round" android:layout_marginBottom="16dp">
        <Button android:id="@+id/btnModeIr" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Infrarouge" android:backgroundTint="@color/navy_light" android:textColor="@color/text_white"/>
        <Button android:id="@+id/btnModeWifi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="Wi-Fi" android:backgroundTint="@color/brown" android:textColor="@color/text_white"/>
    </LinearLayout>

    <Button android:id="@+id/btnBrand" android:layout_width="match_parent" android:layout_height="44dp"
        android:text="Choisir la marque / appareil" android:background="@drawable/btn_round" android:textColor="@color/text_white" android:layout_marginBottom="16dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="20dp">
        <Button android:id="@+id/btnPower" android:layout_width="70dp" android:layout_height="70dp"
            android:text="⏻" android:textSize="26sp" android:textColor="@color/accent_orange" android:background="@drawable/btn_power"/>
        <Space android:layout_width="24dp" android:layout_height="1dp"/>
        <Button android:id="@+id/btnSource" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1"
            android:text="SOURCE" android:textColor="@color/text_white" android:background="@drawable/btn_round"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/btn_round" android:padding="8dp" android:layout_marginEnd="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VOLUME" android:textColor="@color/text_gray" android:textSize="11sp"/>
            <Button android:id="@+id/btnVolUp" android:layout_width="match_parent" android:layout_height="50dp" android:text="+" android:textColor="@color/text_white" android:backgroundTint="@color/navy_light"/>
            <Button android:id="@+id/btnMute" android:layout_width="match_parent" android:layout_height="40dp" android:text="MUTE" android:textSize="11sp" android:textColor="@color/text_white" android:backgroundTint="@color/brown_dark" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/btnVolDown" android:layout_width="match_parent" android:layout_height="50dp" android:text="-" android:textColor="@color/text_white" android:backgroundTint="@color/navy_light" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="@drawable/btn_round" android:padding="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CHAINE" android:textColor="@color/text_gray" android:textSize="11sp"/>
            <Button android:id="@+id/btnChUp" android:layout_width="match_parent" android:layout_height="50dp" android:text="+" android:textColor="@color/text_white" android:backgroundTint="@color/navy_light"/>
            <Button android:id="@+id/btnLast" android:layout_width="match_parent" android:layout_height="40dp" android:text="PREC." android:textSize="11sp" android:textColor="@color/text_white" android:backgroundTint="@color/brown_dark" android:layout_marginTop="4dp"/>
            <Button android:id="@+id/btnChDown" android:layout_width="match_parent" android:layout_height="50dp" android:text="-" android:textColor="@color/text_white" android:backgroundTint="@color/navy_light" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:layout_marginBottom="20dp">
        <Button android:id="@+id/btnUp" android:layout_width="70dp" android:layout_height="50dp" android:text="▲" android:textColor="@color/text_white" android:background="@drawable/btn_round"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
            <Button android:id="@+id/btnLeft" android:layout_width="70dp" android:layout_height="50dp" android:text="◀" android:textColor="@color/text_white" android:background="@drawable/btn_round"/>
            <Button android:id="@+id/btnOk" android:layout_width="70dp" android:layout_height="50dp" android:layout_marginHorizontal="4dp" android:text="OK" android:textColor="@color/navy_dark" android:backgroundTint="@color/accent_orange"/>
            <Button android:id="@+id/btnRight" android:layout_width="70dp" android:layout_height="50dp" android:text="▶" android:textColor="@color/text_white" android:background="@drawable/btn_round"/>
        </LinearLayout>
        <Button android:id="@+id/btnDown" android:layout_width="70dp" android:layout_height="50dp" android:text="▼" android:textColor="@color/text_white" android:background="@drawable/btn_round"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="20dp">
        <Button android:id="@+id/btnBack" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="RETOUR" android:textSize="11sp" android:textColor="@color/text_white" android:background="@drawable/btn_round" android:layout_marginEnd="4dp"/>
        <Button android:id="@+id/btnHome" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="HOME" android:textSize="11sp" android:textColor="@color/text_white" android:background="@drawable/btn_round" android:layout_marginHorizontal="4dp"/>
        <Button android:id="@+id/btnMenu" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:text="MENU" android:textSize="11sp" android:textColor="@color/text_white" android:background="@drawable/btn_round" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <GridLayout android:id="@+id/numPad" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="3" android:rowCount="4"/>

</LinearLayout>
</ScrollView>
